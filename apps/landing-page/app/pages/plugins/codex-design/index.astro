---
/*
 * /plugins/codex-design/ — curated "Codex design" collection.
 *
 * A standalone editorial board (NOT bundled-plugin driven) of the best
 * real, external skills for doing design with OpenAI Codex (openai/skills,
 * MengTo/Skills, etc.). Positions Open Design as the home for designing
 * with Codex and drives to the client download + the awesome-codex-design
 * list. Content comes from `_lib/codex-design.ts`; page chrome
 * (breadcrumb, nav) from `getPluginsCopy(locale)`.
 *
 * Visual language is deliberately the SAME as the rest of /plugins/*:
 * editorial tpl-card DNA (1.5px ink border, hard offset hover shadow,
 * media bleed, mono uppercase labels, dark full-width CTA), the shared
 * `.plugins-*` hero primitives, and the site's ink/bone palette. It must
 * read as one family with the plugin hub.
 */
import Layout from '../../../_components/sub-page-layout.astro';
import { getPluginsCopy } from '../../../_lib/plugins-i18n';
import { localeFromPath, localizedHref } from '../../../i18n';
import {
  CODEX_COLLECTION,
  CODEX_SKILLS,
  AWESOME_REPO_URL,
  OD_DOWNLOAD_URL,
  OD_GUIDE_HREF,
} from '../../../_lib/codex-design';

const locale = localeFromPath(Astro.url.pathname);
const pcopy = getPluginsCopy(locale);
const href = (path: string) => localizedHref(path, locale);

const c = CODEX_COLLECTION;
const title = `${c.eyebrow} · ${c.heading} · Open Design`;
const description = c.lede;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${c.eyebrow} — ${c.heading}`,
    description: c.lede,
    url: new URL('/plugins/codex-design/', Astro.site).toString(),
    numberOfItems: CODEX_SKILLS.length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: CODEX_SKILLS.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(`/plugins/codex-design/${s.slug}/`, Astro.site).toString(),
    })),
  },
];
---

<Layout title={title} description={description} active="plugins" jsonLd={jsonLd}>
  <div class="codex-page">
    <section class="codex-hero">
      <div class="codex-hero-copy">
        <nav class="label detail-crumb" aria-label="Breadcrumb">
          <a href={href('/plugins/')}>{pcopy.hubLabel}</a>
          <span class="crumb-sep" aria-hidden="true">·</span>
          <span aria-current="page">{c.eyebrow}</span>
        </nav>
        <p class="plugins-eyebrow">Curated collection</p>
        <h1 class="display">{c.heading}<span class="dot">.</span></h1>
        <p class="lead">{c.lede}</p>
        <ul class="plugins-stats">
          {c.stats.map((s) => (
            <li><strong>{s.value}</strong> {s.label}</li>
          ))}
        </ul>
        <div class="plugins-hero-cta">
          <a class="btn btn-primary" href={href(OD_DOWNLOAD_URL)}>Download Open Design</a>
          <a class="btn btn-ghost plugins-star-btn" href={AWESOME_REPO_URL} target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .6l2.02 4.28 4.6.6-3.37 3.18.88 4.68L8 11.5 3.87 13.7l.88-4.68L1.38 5.85l4.6-.6z"/></svg>
            Star the list
          </a>
          <a class="codex-textlink" href={href(OD_GUIDE_HREF)}>Read the Codex design guide →</a>
        </div>
      </div>
      <div class="codex-hero-art" aria-hidden="true">
        <img src="/plugins/codex-design/hero.webp" alt="" width="960" height="640" loading="eager" />
      </div>
    </section>

    <section class="codex-why" aria-label="Why these skills">
      <p class="codex-why-intro">{c.intro}</p>
      <ul class="codex-cat-strip">
        {c.categories.map((cat) => (
          <li>
            <span class="codex-cat-key">{cat.key}</span>
            <span class="codex-cat-blurb">{cat.blurb}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="codex-skills" aria-label="Codex design skills">
      <div class="codex-skill-grid">
        {CODEX_SKILLS.map((s) => (
          <article class="tpl-card">
            <a class="tpl-media" href={href(`/plugins/codex-design/${s.slug}/`)}>
              <img class="tpl-media-poster" src={s.image} alt="" loading="lazy" />
              <span class="tpl-media-kind">{s.category}</span>
            </a>
            <div class="tpl-meta">
              <span class="tpl-author">{s.badge}</span>
              <span>Skill</span>
            </div>
            <a class="tpl-excerpt" href={href(`/plugins/codex-design/${s.slug}/`)}>
              <span class="tpl-excerpt-head">What it does</span>
              <span class="tpl-excerpt-title">{s.name}</span>
              <span class="tpl-excerpt-body">{s.tagline}</span>
            </a>
            <div class="tpl-actions">
              <a class="tpl-cta" href={href(`/plugins/codex-design/${s.slug}/`)}>View skill</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="codex-closer">
      <div class="codex-closer-inner">
        <h2>Skip the setup — design with Codex inside Open Design</h2>
        <p>
          Open Design is the open-source, agent-native design workspace that runs around Codex:
          it keeps your systems, skills, and templates consistent so the agent ships work you own.
          Bring your own key, own your output.
        </p>
        <div class="plugins-hero-cta">
          <a class="btn btn-primary" href={href(OD_DOWNLOAD_URL)}>Download Open Design</a>
          <a class="btn btn-ghost" href={href('/plugins/')}>Browse all plugins</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    /* Center in the shared safe area and neutralize the global
       `section { padding: 130px 0 }` rule (rhythm comes from margins). */
    .codex-page { max-width: 1180px; margin-inline: auto; }
    .codex-page > section { padding-block: 0; }

    .detail-crumb a { color: inherit; text-decoration: none; }
    .detail-crumb a:hover { color: var(--ink); text-decoration: underline; }
    .detail-crumb .crumb-sep { margin: 0 0.45em; opacity: 0.55; }

    /* Hero — editorial two-column, framed illustration. */
    .codex-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(28px, 4vw, 64px);
      align-items: center;
      margin-bottom: clamp(48px, 6vw, 80px);
    }
    .codex-hero .plugins-eyebrow { margin-top: 6px; }
    .codex-hero .display { margin: 0.05em 0 0.3em; text-wrap: balance; }
    .codex-hero .lead { max-width: 46ch; }
    .codex-hero .plugins-stats,
    .codex-hero .plugins-hero-cta { justify-content: flex-start; }
    .codex-textlink {
      font-size: 0.9rem; color: var(--ink-mute); text-decoration: none;
      align-self: center;
    }
    .codex-textlink:hover { color: var(--ink); text-decoration: underline; }
    .codex-hero-art {
      border: 1.5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      background: var(--paper-warm);
      overflow: hidden;
    }
    .codex-hero-art img { width: 100%; height: auto; display: block; }

    /* Why strip — editorial cards. */
    .codex-why { margin-bottom: clamp(44px, 6vw, 72px); }
    .codex-why-intro {
      max-width: 64ch; font-size: 1.05rem; line-height: 1.6;
      color: var(--ink-soft); margin: 0 0 1.8em;
    }
    .codex-cat-strip {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    .codex-cat-strip li {
      border: 1.5px solid var(--ink);
      background: var(--bone);
      padding: 20px 22px;
    }
    .codex-cat-key {
      display: block; font-family: var(--mono);
      font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink); font-weight: 600; margin-bottom: 0.7em;
    }
    .codex-cat-blurb {
      display: block; font-size: 0.92rem; line-height: 1.5; color: var(--ink-soft);
    }

    /* Skills grid — `.codex-skill-grid` (tpl-card DNA) is global in sub-pages.css. */
    .codex-skills { margin-bottom: clamp(56px, 8vw, 96px); }

    /* Closer. */
    .codex-closer {
      border-top: 1.5px solid var(--ink);
      padding-top: clamp(36px, 5vw, 56px) !important;
    }
    .codex-closer-inner { max-width: 62ch; }
    .codex-closer h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); margin: 0 0 0.5em; text-wrap: balance; }
    .codex-closer p { font-size: 1.02rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 1.5em; }
    .codex-closer .plugins-hero-cta { justify-content: flex-start; }

    @media (max-width: 900px) {
      .codex-hero { grid-template-columns: 1fr; }
      .codex-hero-art { order: -1; max-width: 480px; }
      .codex-cat-strip { grid-template-columns: 1fr; }
      .codex-skill-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .codex-skill-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
