---
/*
 * /<locale>/plugins/codex-design/<skill>/ — localized wrapper for a
 * curated Codex design skill detail page. Emits locale × skill paths.
 */
import CodexSkillPage from '../../../../plugins/codex-design/[skill]/index.astro';
import { CODEX_SKILLS, type CodexSkill } from '../../../../../_lib/codex-design';
import { DEFAULT_LOCALE, LANDING_LOCALES } from '../../../../../i18n';

export function getStaticPaths() {
  const locales = LANDING_LOCALES.filter((l) => l.code !== DEFAULT_LOCALE);
  return locales.flatMap((locale) =>
    CODEX_SKILLS.map((skill) => ({
      params: { locale: locale.code, skill: skill.slug },
      props: { skill },
    })),
  );
}

const { skill } = Astro.props as { skill: CodexSkill };
---

<CodexSkillPage skill={skill} />
